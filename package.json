{
	"name": "north",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.5",
			"@tanstack/react-form": "^1.28.0",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "cd apps/web && npm run build",
		"vercel-build": "cd apps/web && npm run build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:reset": "supabase db reset",
		"supabase:studio": "supabase status",
		"supabase:link:dev": "scripts/supabase-link.sh dev",
		"supabase:link:prod": "scripts/supabase-link.sh prod",
		"check": "biome check --write .",
		"check:ci": "biome check .",
		"check:secrets": "scripts/check-client-bundle-secrets.sh",
		"check:contrast": "bun scripts/check-token-contrast.ts",
		"postinstall": "lefthook install || true",
		"android": "expo run:android",
		"ios": "expo run:ios"
	},
	"dependencies": {
		"@north/env": "workspace:*",
		"@north/tokens": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:",
		"expo": "~54.0.33",
		"react": "19.1.0",
		"react-native": "0.81.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@north/config": "workspace:*",
		"@types/node": "^22.13.14",
		"lefthook": "^2.1.8",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"overrides": {
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"packageManager": "bun@1.3.1",
	"version": "1.0.0"
}
