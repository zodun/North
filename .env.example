# Copy to `.env` (root) and fill in real values, then run: supabase stop && supabase start
# The Supabase CLI reads this for the env(...) refs in supabase/config.toml
# ([edge_runtime.secrets]) and injects them into the local edge functions.
#
# Without these, the AI functions fall back to generic, non-personalized output:
#   - plan-month   → suggested goal + 4-week plan + daily tasks  (ANTHROPIC_API_KEY)
#   - signal-summary, task-suggestion                            (ANTHROPIC_API_KEY)
#   - reflect (journal analysis)                                 (OPENAI_API_KEY)

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
