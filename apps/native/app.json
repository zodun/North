{
	"expo": {
		"name": "north",
		"slug": "north",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "north",
		"userInterfaceStyle": "automatic",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "app.north.client",
			"usesAppleSignIn": true,
			"infoPlist": {
				"UIBackgroundModes": ["remote-notification"],
				"CFBundleURLTypes": [
					{
						"CFBundleURLSchemes": [
							"com.googleusercontent.apps.671690703209-6jd6qasv4dl8tn5jbe8ugeoviu1ljrp4"
						]
					}
				],
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "app.north.client",
			"permissions": ["android.permission.RECORD_AUDIO"]
		},
		"web": {
			"output": "single-page",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-video",
			"expo-apple-authentication",
			"expo-web-browser",
			[
				"expo-image-picker",
				{
					"cameraPermission": "North needs camera access to film your progress videos.",
					"microphonePermission": "North needs microphone access to record audio in your videos.",
					"photosPermission": "North needs photo library access to pick videos from your library."
				}
			],
			[
				"expo-notifications",
				{
					"color": "#ffffff"
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "7a63d28f-a17f-4070-9a61-d335925d8c96"
			}
		},
		"updates": {
			"url": "https://u.expo.dev/7a63d28f-a17f-4070-9a61-d335925d8c96"
		}
	}
}
