# apps/native · environment template
#
# Copy to .env (gitignored) for local `expo start`.
# For EAS builds the same variables (with profile-specific values)
# live in EAS secrets — see apps/native/README.md and
# docs/supabase-projects.md.
#
# Only EXPO_PUBLIC_* names are bundled into the client. There is no
# server-only counterpart on native — anything secret-y lives in
# Supabase Edge Functions or the admin app, never here.

# Local dev:    EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Dev cloud:    EXPO_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
#               (or set per-profile via `eas secret:create`)
# Preview/prod: https://<prod-project-ref>.supabase.co via eas secrets
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — wire in M1.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google OAuth per-platform client IDs (DEC-18). Get from Google
# Cloud Console → Credentials. Native uses iOS + Android + web all
# three (web ID is needed by expo-auth-session as the OIDC issuer).
# Leave blank to hide the Google button.
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
