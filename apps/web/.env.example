# apps/web · environment template
#
# Copy to .env (gitignored) for local development.
# For the deployed admin app, set these same variables in the host's
# env-var UI (Vercel / Cloudflare Pages / Fly / etc.) with prod values.
#
# See docs/supabase-projects.md for how to fill these in per environment
# and docs/secrets.md for the wider secret-handling rule.

# ─────────────────────────────────────────────────────────────────────
# APP_ENV (DEC-16) — environment identity. NOT NODE_ENV.
#   development → talks to north-dev Supabase project; allows seed data
#   production  → talks to north-prod Supabase project
# Default is development when unset.
# ─────────────────────────────────────────────────────────────────────
APP_ENV=development

# ─────────────────────────────────────────────────────────────────────
# Supabase
# Local dev:  use http://127.0.0.1:54321 + the keys printed by
#             `supabase status` after `supabase start`.
# Dev cloud:  use https://<dev-project-ref>.supabase.co + the dev
#             project's keys from Settings → API in the Supabase
#             dashboard.
# Prod:       host's env-var UI, never a local file.
# ─────────────────────────────────────────────────────────────────────

# Public (browser bundle). Required.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required. NEVER ship the service-role key to the client —
# the secrets leak-check (scripts/check-client-bundle-secrets.sh) blocks it.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────
# AI summary layer (signal-summary Edge Function, DEC-07).
# Also set these as Supabase secrets per environment with
#   supabase secrets set OPENAI_API_KEY=...
#   supabase secrets set SUMMARY_TRIGGER_SECRET=$(openssl rand -hex 32)
# so the Edge Function picks them up; the local copies here let
# server-action code in apps/web invoke OpenAI directly during dev.
# ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
SUMMARY_TRIGGER_SECRET=

# Social OAuth providers (DEC-18). Supabase's config.toml reads these
# via env() substitution. Get values from Google Cloud Console
# (OAuth 2.0 Client IDs) and Apple Developer Portal (Sign in with
# Apple). Leave blank if you only want magic-link sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Optional integrations (M2/M3 — leave blank until wired).
# ─────────────────────────────────────────────────────────────────────
# Cloudinary (DEC-20). Cloud name is public (appears in delivery URLs);
# API key + secret are server-only (signed-upload endpoint at
# /api/cloudinary/sign). All optional locally — the endpoint returns
# 503 when these aren't set, so dev without Cloudinary still boots.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Legacy single-string form. Cloudinary's SDK accepts either
# CLOUDINARY_URL OR the discrete trio above; the admin app uses the
# trio so the API secret stays server-only by name.
CLOUDINARY_URL=

POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
